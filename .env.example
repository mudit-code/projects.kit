# ==============================================================================
# Kanpur Institute of Technology - projects.kit Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, private keys, or actual credentials to version control.
# ==============================================================================

# Authentication & Session Security (Required for signed session cookies)
# Generate a secure 32+ character random secret in production (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace_with_a_secure_random_key_min_32_characters

# Base URL for public links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL via Prisma ORM)
# DATABASE_URL: Pooled connection string (e.g., Neon or Supabase PgBouncer pooler)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&schema=kit_projects"
# DIRECT_URL: Direct unpooled connection string (used for migrations and schema push)
DIRECT_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&schema=kit_projects"

# Email Delivery Configuration
# Options:
#   - "log" (Default, Safe): Logs full email contents to stdout/console. No network calls or real emails sent.
#   - "smtp": Dispatches actual emails via the configured SMTP transport below.
EMAIL_MODE=log

# Safe Testing Override (Optional)
# If set, ALL outgoing emails will be redirected to this address instead of real student emails.
# Useful for manual testing and staging environments to prevent spamming actual students.
# Leave blank to send to real student recipients when in "smtp" mode.
EMAIL_TEST_RECIPIENT=

# SMTP Server Credentials (Only used when EMAIL_MODE=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@sandbox.mailgun.org
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="KIT Project Cell <projects@kit.ac.in>"
EMAIL_REPLY_TO="Rahul Singh <hod@kit.ac.in>"
